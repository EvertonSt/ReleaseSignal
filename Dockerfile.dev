FROM node:20-alpine

RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Install dependencies
COPY package.json pnpm-lock.yaml ./
RUN corepack enable pnpm && pnpm install --frozen-lockfile

# Copy source (overridden by volume mount in docker-compose.override.yml)
COPY . .

EXPOSE 3000

CMD ["sh", "-c", "npx prisma generate && npx next dev --port 3000 --hostname 0.0.0.0"]
