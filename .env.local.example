# ── ReleaseSignal Environment Configuration ────────────────────────────────
# Copy this file to .env.local and fill in your values.
# For Docker, see docker-compose.yml for service-specific variables.

# ── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Demo Mode ──────────────────────────────────────────────────────────────
# Set to "true" to bypass authentication and use synthetic demo data.
# The app will display a "Demo mode" banner on every page.
NEXT_PUBLIC_DEMO_MODE=true

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Local:   postgresql://releasesignal:releasesignal_dev_password@localhost:5432/releasesignal
# Docker:  postgresql://releasesignal:releasesignal_dev_password@postgres:5432/releasesignal
DATABASE_URL=postgresql://releasesignal:releasesignal_dev_password@localhost:5432/releasesignal

# ── Redis ──────────────────────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Docker:  redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── Authentication (NextAuth) ──────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-in-production-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── Ingestion API (POST /api/ingress) ──────────────────────────────────────
# Bearer token required by the CI ingestion endpoint. Generate one with:
#   openssl rand -base64 32
# With this unset and demo mode off, the endpoint answers 503 rather than
# accepting an anonymous write - it fails closed, never open.
INGEST_API_KEY=dev-ingest-key-change-in-production-use-openssl-rand-base64-32

# ── GitHub OAuth ───────────────────────────────────────────────────────────
# Create a GitHub OAuth App at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App (for repository integration) ────────────────────────────────
# Create a GitHub App at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# ── AI Providers (optional) ────────────────────────────────────────────────
# Used for failure analysis and explanations. Leave empty for deterministic rules only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
